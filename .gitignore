# Environment
.env
.env.local

# Credential dumps. digitalocean-credentials.txt sat at the repo root and was
# committed; this stops the next one. NOTE: removing that file does not purge
# it from git history - that is a separate, deliberate decision.
*credential*
*credentials*

# Runtime logs (both repo-root logs/ and backend/logs/)
logs/
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
ENV/

# Node
node_modules/
dist/
build/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker
postgres_data/
redis_data/

# Uploads
uploads/*
!uploads/.gitkeep

# OS
.DS_Store
Thumbs.db

.cache/

# Database backups/dumps
*.dump
*.dump.gz
*.sql
!docker/postgres-init/*.sql
!scripts/init_database.sql
!docker/postgres-post-migrate/*.sql
backup_extract/
springais_backup*
local_backup*
