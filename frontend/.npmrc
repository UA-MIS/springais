# Network resilience for the platform's CI egress path (2026-09-10 npm ci
# incident). Raises npm's default retry/timeout tolerance for a slow or
# flapping link and caps concurrency, which is cheap and never hurts.
#
# NOTE: this alone did NOT fix the actual Kaniko-embedded `npm ci` failure --
# UA-MIS/ida-llm proved the same errno -110 mid-stream read timeout fires and
# fails in ~10-20s, faster than any retry policy here would ever engage. The
# real fix for the Dockerfile-embedded install is the explicit retry loop in
# this component's Dockerfile. This file still helps: local `npm ci`, and the
# CI "checks" (lint/test) job, which runs npm directly against a full
# checkout (not through Kaniko's partial COPY context, so this file is
# actually present when that job runs).
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=300000
maxsockets=6
