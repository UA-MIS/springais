# -----------------------------------------------------------------------------
# SpringAis environment variables
# Copy to .env and fill in real values. Never commit .env.
# -----------------------------------------------------------------------------

# --- Secrets -----------------------------------------------------------------

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-REPLACE_ME

# O*NET API key (register at https://services.onetcenter.org/reference)
ONET_API_KEY=REPLACE_ME

# JWT signing secret. Generate a fresh one for every deployment:
#   openssl rand -hex 32
# Do NOT reuse dev values (e.g. "i-am-dev") in production.
JWT_SECRET_KEY=REPLACE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# --- Internal service URLs ---------------------------------------------------
# Used by the backend container; hostnames resolve on the compose network.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/springais
REDIS_URL=redis://redis:6379/0

# --- Frontend ----------------------------------------------------------------
# Public origin the browser uses to reach the API. Frontend code appends /api
# internally, so set this to the scheme + host only (no trailing /api).
#
#   Local dev:  http://localhost:8080
#   Production: https://myskillbridge.me
VITE_API_URL=https://myskillbridge.me
